easyblock = "CMakeMake"

name = "kokkos"
version = "4.2.01"
versionsuffix = "-DTK-23.10.1"
homepage = "https://kokkos.org/"

description = """
 kokkos Kokkos Core implements a programming model in C++ for writing performance portable applications 
 targeting all major HPC platforms. For that purpose it provides abstractions for both parallel execution 
 of code and data management. Kokkos is designed to target complex node architectures with N-level memory 
 hierarchies and multiple types of execution resources. It currently can use CUDA, HIP, SYCL, HPX, OpenMP 
 and C++ threads as backend programming models with several other backends in development.
"""

toolchain = {"name": "GCCcore", "version": "12.3.0"}
toolchainopts = {"pic": True}

source_urls = [("https://github.com/kokkos/kokkos/archive/refs/tags/")]
sources = ["%(version)s.tar.gz"]

builddependencies = [("CMake", "3.26.3"), ("binutils", "2.40")]

dependencies = [
    ("DTK", "23.10.1", "", SYSTEM),
]

configopts = " \
 -DCMAKE_INSTALL_PREFIX=%(installdir)s \
 -DCMAKE_CXX_COMPILER=hipcc \
 -DCMAKE_CXX_STANDARD=20 \
 -DKokkos_ENABLE_OPENMP=ON \
 -DKokkos_ENABLE_HIP=ON \
 "

separate_build_dir = True

sanity_check_paths = {
    "files": ["bin/nvcc_wrapper","lib/libkokkoscore.a"],
    "dirs": ["bin","include","lib"],
}

moduleclass = "numlib"
